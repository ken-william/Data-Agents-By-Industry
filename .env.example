# Google ADK Gemini Live Bidi-Streaming Configuration
# Reference: Kazunori Sato (Google Cloud) - ADK Bidi-streaming in 5 minutes (https://youtu.be/vLUkAGeLR1k)

# 1. Use Vertex AI Native Audio Live Models (Cloud IAM Token / Service Account)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=data-agents-by-industry
GOOGLE_CLOUD_LOCATION=us-central1

# 2. Live Agent Native-Audio Model Specification
DEFAULT_VERTEX_AGENT_MODEL=gemini-live-2.5-flash-native-audio
DEFAULT_GEMINI_AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# 3. Optional Google AI Studio Fallback Key
# GEMINI_API_KEY=
