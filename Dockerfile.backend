FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for Tier 2 (ADK Orchestrator) & Tier 3 (MCP Toolbox)
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy only backend source code and agent configurations
COPY backend/ ./backend/
COPY agents/ ./agents/

# Environment configuration
ENV PORT=8080
ENV GOOGLE_CLOUD_PROJECT=data-agents-by-industry
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

# Start pure headless FastAPI / ADK Orchestrator / MCP Toolbox server
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
