        "update_frequency": "daily"
      },
      "aspects": {
        "business_governance": {
          "steward": "CNC Analytics Team",
          "data_owner": "Directeur de la Distribution Cinématographique"
        },
        "data_quality_aspect": {
          "completeness_target": "99.5%",
          "validity_rules": ["RISQUE_FLOP_BETWEEN_0_AND_100", "BUDGET_POSITIVE"]
        }
      },
      "data_quality_rules": [
        {
          "display_name": "Check Risque Flop Valid Range",
          "rule_type": "RANGE_CHECK",
          "dimension": "VALIDITY",
          "parameters": {"min_value": 0.0, "max_value": 100.0}
        }
      ],
      "related_entries": [
        {
          "resource_name": "cnc_films_nouveautes_titres_boxoffice",
